{
  "name": "forgeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "web",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run build --workspace web",
    "start": "node server/app.js",
    "worker": "node server/worker.js",
    "check": "npm run check --workspace web && node scripts/check-js.js",
    "worker:once": "node server/worker.js --once"
  }
}
